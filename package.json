{
  "name": "practicalsystem",
  "private": true,
  "version": "0.1.0",
  "description": "数二备考系统：上传每天的学习内容，自动评估、整理、总结、记忆，找出薄弱点",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:server": "npm run dev -w @ps/server",
    "dev:web": "npm run dev -w @ps/web",
    "dev:mobile": "npm run start -w @ps/mobile",
    "build:web": "npm run build -w @ps/web",
    "build:demo": "npm run build:demo -w @ps/web",
    "start": "npm run start -w @ps/server",
    "test": "npm test -w @ps/core",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "engines": {
    "node": ">=22.13"
  }
}
